              "en": "Miami 120",
              "es": "Miami 120"
            },
            {
              "en": "Miami 340",
              "es": "Miami 340"
            },
            {
              "en": "Miami 290",
              "es": "Miami 290"
            }
          ]
        }
      ]
    },
    {
      "id": "screen-3",
      "title": {
        "en": "Screen 3",
        "es": "Pantalla 3"
      },
      "fields": [
        {
          "name": "collapsible_section_1",
          "label": {
            "en": "Collapsible section",
            "es": "Sección plegable"
          },
          "type": "accordion"
        }
      ]
